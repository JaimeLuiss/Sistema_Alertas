<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeColor="#EAEAEA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCourseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fundamentos de programación"
                android:textColor="#212121"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.8"
                android:textColor="#D32F2F"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Barra de progreso -->
        <ProgressBar
            android:id="@+id/progressCourse"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="65"
            android:progressTint="#FF6B00" />

        <!-- Avance -->
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Avance del curso: 65%"
            android:textColor="#757575"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvPeriodo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Periodo 2026-1"
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- Estado -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Riesgo crítico"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Recomendación -->
        <TextView
            android:id="@+id/tvRecommendation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Asistir a tutorías y reforzar ejercicios."
            android:textColor="#616161"
            android:textSize="13sp" />

        <!-- Link a Bienestar -->
        <TextView
            android:id="@+id/tvWellnessLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Agenda tu cita aquí"
            android:textColor="#FF6B00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:autoLink="web" />

        <!-- Botones principales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewGrades"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FF6B00"
                android:text="Ver Notas"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewSyllabus"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#FFF3E0"
                android:text="Ver Cátedra"
                android:textAllCaps="false"
                android:textColor="#FF6B00"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="#FF6B00"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Botón volver -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#F5F5F5"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="#616161"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#DADADA"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>